---
import "../../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "buttr — coffee & bakery, shop online",
  description = "A small bakery and slow coffee — delivered warm to your door.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/buttr/stickers/croissant.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Fredoka:wght@400;500;600;700&display=swap"
    />
    <slot name="seo-tags" />
  </head>
  <body>
    <slot />
  </body>
</html>
