---
import type { CartItem, MenuHalf } from "../lib/wix/types";
import { halfOrdinal, halfVisual, stripHtml } from "../lib/buttr";
import ItemRow from "./item-row.astro";

interface Props {
  half: MenuHalf;
  index: number;
  cartByHandle: Map<string, CartItem>;
}
const { half, index, cartByHandle } = Astro.props;

const reverse = index % 2 === 1;
const visual = halfVisual(half.slug, index);
const description = stripHtml(half.description);
---

<div class={`menu-group${reverse ? " reverse" : ""}`}>
  <div class="menu-image reveal">
    <img src={visual.mascot} alt={`${half.title} mascot`} loading="lazy" />
  </div>
  <div class="menu-body">
    <div class="menu-group-head">
      <img class="head-sticker" src={visual.headSticker} alt="" />
      <div class="group-label">Half {halfOrdinal(index)}</div>
      <h3 class="group-title reveal">
        The <em>{half.title}.</em>
      </h3>
      {description && <p class="group-desc reveal">{description}</p>}
    </div>
    {
      half.subgroups.map((sg) => (
        <div class="subgroup reveal">
          <div class="subgroup-head">
            <span class="subgroup-name">{sg.title.toUpperCase()}</span>
            <span class="subgroup-rule" />
            <span class="subgroup-count">{sg.products.length}</span>
          </div>
          {sg.products.map((p) => (
            <ItemRow product={p} cartLine={cartByHandle.get(p.handle)} />
          ))}
        </div>
      ))
    }
  </div>
</div>
