---
import { actions } from "astro:actions";
import type { CartItem, Product } from "../lib/wix/types";
import { formatMoney, stripHtml, variantPayload } from "../lib/buttr";

interface Props {
  product: Product;
  cartLine?: CartItem;
}
const { product, cartLine } = Astro.props;

const variant = product.variants[0];
const isSoldOut = !product.availableForSale || !variant?.availableForSale;
const img = product.featuredImage?.url ? product.featuredImage : product.images[0];
const price = formatMoney(
  product.priceRange.minVariantPrice.amount,
  product.priceRange.minVariantPrice.currencyCode,
);
const qty = cartLine?.quantity ?? 0;
const description = stripHtml(product.description);
---

<div class={`item-row${isSoldOut ? " sold-out" : ""}`}>
  <a class="item-thumb" href={`/product/${product.handle}`} aria-label={product.title}>
    {
      img?.url ? (
        <img src={img.url} alt={img.altText || product.title} loading="lazy" />
      ) : (
        <div style="width:100%;height:100%;background:var(--butter)" />
      )
    }
  </a>
  <div class="item-info">
    <div class="item-top">
      <span class="item-name">{product.title}</span>
      <span class="item-price">{price}</span>
    </div>
    {description && <div class="item-desc">{description}</div>}
  </div>
  <div class="item-action">
    {
      isSoldOut ? (
        <span class="sold-tag">Sold out</span>
      ) : (
        <>
          <span class="item-qty" data-handle={product.handle} hidden={qty === 0}>
            {qty}
          </span>
          <form method="post" action={actions.addItemToCart} data-cart="add" data-handle={product.handle}>
            <input type="hidden" name="productId" value={product.id} />
            <input type="hidden" name="variant" value={variantPayload(product)} />
            <button type="submit" class="item-add-btn" aria-label={`Add ${product.title} to box`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:14px;height:14px">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
            </button>
          </form>
        </>
      )
    }
  </div>
</div>
